# JARVIS configuration — copy to `.env` (same folder) and fill in. `.env` is git-ignored.
# Never put real keys in this example file, in the frontend, or in chat.

APP_ENV=development
# Keep loopback. Remote access goes through Tailscale Serve (HTTPS) to this same origin.
APP_HOST=127.0.0.1
APP_PORT=8787
APP_TIMEZONE=Asia/Jerusalem
# Optional. If empty, a random secret is generated once into data/secret.key.
APP_AUTH_SECRET=
# Your tailnet hostname, e.g. my-pc.tail1234.ts.net (comma separated). Needed for iPhone access.
APP_ALLOWED_HOSTS=
# Set true when using Tailscale Serve (HTTPS) so session cookies are Secure.
APP_COOKIE_SECURE=false

# ---- Local LLM (Ollama) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# 8 GB VRAM: 4096-8192 is safe for qwen3:8b Q4. 16 GB VRAM: 8192-16384.
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_THINK=false
VRAM_PROFILE=8gb

# ---- Speech-to-text (local faster-whisper) ----
STT_PROVIDER=faster-whisper
# tiny | base | small | medium | large-v3 (larger = slower, more accurate; Hebrew benefits from small+)
STT_MODEL=small
# cpu (safe default) or cuda (requires CUDA 12 + cuDNN 9 runtime for CTranslate2)
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# Empty = auto-detect language per recording
STT_LANGUAGE=

# ---- Text-to-speech (Fish Audio, cloud) ----
TTS_PROVIDER=fish
FISH_API_KEY=
# Model header for POST /v1/tts: s1 | s2-pro | s2.1-pro | s2.1-pro-free (see docs/VOICE_DESIGN.md)
FISH_MODEL=s2.1-pro
# Voice model id from the Fish Audio library (can also be set in Settings → Voice)
FISH_REFERENCE_ID=
FISH_HEBREW_REFERENCE_ID=
# mp3 | wav | opus
FISH_OUTPUT_FORMAT=mp3
# normal | balanced | low
FISH_LATENCY=balanced

# ---- Optional cloud LLM (disabled by default) ----
ENABLE_GROQ=false
GROQ_API_KEY=
GROQ_MODEL=

# ---- Not implemented yet (Phase 5); kept false ----
ENABLE_WAKE_WORD=false
ENABLE_HOME_ASSISTANT=false
