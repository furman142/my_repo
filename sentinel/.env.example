# SENTINEL configuration. Copy to .env and edit. Never commit .env.

# Where the dashboard listens.
#   127.0.0.1  -> this computer only (default, safest)
#   0.0.0.0    -> whole home network (LAN). Requires SENTINEL_PASSWORD.
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8080

# Login password for the dashboard. Required when SENTINEL_HOST is not loopback.
# Leave empty for localhost-only use without a login screen.
SENTINEL_PASSWORD=

# Extra host names / IPs allowed in the Host header (DNS-rebinding protection),
# comma separated, e.g. your PC's LAN IP: 192.168.1.20
SENTINEL_ALLOWED_HOSTS=

# go2rtc internal API port (always bound to 127.0.0.1, protected by a generated password)
GO2RTC_API_PORT=1984
# WebRTC (low latency, needed by iPhone Safari) uses its own media port, TCP+UDP, on your LAN.
# Default: off when SENTINEL_HOST is 127.0.0.1 (the player then uses MSE over the dashboard's
# own WebSocket - no extra port), on when SENTINEL_HOST exposes the dashboard to the LAN.
# GO2RTC_WEBRTC=false
GO2RTC_WEBRTC_PORT=8555
