# ─────────────────────────────────────────────────────────────
# ProfilePilot environment configuration
#
# The app runs WITHOUT any of these set — it falls back to a
# deterministic heuristic analyzer so you can develop the full
# UX offline. Set ANTHROPIC_API_KEY to enable real AI analysis.
# ─────────────────────────────────────────────────────────────

# --- AI (required for real analysis; optional for demo mode) ---
# When unset, the app uses lib/ai/mock-analyzer.ts instead.
ANTHROPIC_API_KEY=

# Model overrides (optional). Defaults are set in src/lib/ai/config.ts
PROFILEPILOT_VISION_MODEL=claude-opus-5
PROFILEPILOT_TEXT_MODEL=claude-opus-5

# --- Auth (optional; scaffolded, see docs/INTEGRATIONS.md) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Database (optional; the Improvement Tracker persists here) ---
DATABASE_URL=

# --- Redis cache + rate limiting (optional) ---
REDIS_URL=

# --- Supabase Storage (optional; only if the user opts into saving photos) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (optional; Pro tier) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID=
